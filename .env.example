# Copy to .env and fill in real values. NEVER commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

PORT=4000
NODE_ENV=development

# Required. No default exists: the server refuses to start without it.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Minimum 16 characters in development, 32 in production.
JWT_SECRET=REPLACE_WITH_A_GENERATED_SECRET

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
MAX_PAGE_SIZE=100

# Self-service company signup (POST /api/auth/signup)
ALLOW_PUBLIC_SIGNUP=true
SIGNUP_RATE_LIMIT=10

# Login throttle (POST /api/auth/login), per client address per window
LOGIN_RATE_LIMIT=30
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Set to true only when the API really is behind a reverse proxy
TRUST_PROXY=false

# Password given to every seeded demo user
SEED_PASSWORD=Password123!
