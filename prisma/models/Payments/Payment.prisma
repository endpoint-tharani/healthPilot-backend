model Payment {
  id            String        @id @default(uuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])
  branchId      String?
  branch        Branch?       @relation(fields: [branchId], references: [id])
  supplierId    String?
  supplier      Supplier?     @relation(fields: [supplierId], references: [id])
  paymentNumber String
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  paymentDate   DateTime      @default(now())
  reference     String?
  notes         String?
  /** Where this payment stands with the books. Mirrors Document.accountingStatus. */
  accountingStatus   AccountingStatus @default(NOT_REQUIRED)
  accountingMessage  String?
  accountingPostedAt DateTime?
  createdById   String
  createdBy     User          @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  allocations    PaymentAllocation[]
  journalEntries JournalEntry[]     @relation("JournalSourcePayment")

  @@unique([companyId, paymentNumber])
  @@index([companyId])
  @@index([supplierId])
  @@index([companyId, accountingStatus])
}
