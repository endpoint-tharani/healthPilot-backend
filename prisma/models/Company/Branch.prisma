model Branch {
  id        String     @id @default(uuid())
  companyId String
  company   Company    @relation(fields: [companyId], references: [id])
  code      String
  name      String
  type      BranchType
  address   String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  users                      User[]
  userBranchAccess           UserBranchAccess[]
  documents                  Document[]             @relation("PrimaryBranchDocuments")
  sourceBranchDocuments      Document[]             @relation("SourceBranchDocuments")
  destinationBranchDocuments Document[]             @relation("DestinationBranchDocuments")
  inventoryTransactions      InventoryTransaction[]
  payments                   Payment[]
  notifications              Notification[]
  accountMappings            AccountMapping[]
  journalEntries             JournalEntry[]
  journalLines               JournalLine[]

  @@unique([companyId, code])
  @@index([companyId])
}
