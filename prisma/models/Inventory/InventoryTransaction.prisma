model InventoryTransaction {
  id                 String                   @id @default(uuid())
  companyId          String
  company            Company                  @relation(fields: [companyId], references: [id])
  branchId           String
  branch             Branch                   @relation(fields: [branchId], references: [id])
  productId          String
  product            Product                  @relation(fields: [productId], references: [id])
  batchId            String
  batch              Batch                    @relation(fields: [batchId], references: [id])
  documentId         String?
  document           Document?                @relation(fields: [documentId], references: [id])
  documentLineItemId String?
  documentLineItem   DocumentLineItem?        @relation(fields: [documentLineItemId], references: [id])
  transactionType    InventoryTransactionType
  quantity           Decimal                  @db.Decimal(12, 2)
  unitCost           Decimal                  @db.Decimal(12, 2)
  totalCost          Decimal                  @db.Decimal(12, 2)
  stockStatus        StockStatus              @default(USABLE)
  transactionDate    DateTime                 @default(now())
  notes              String?
  createdById        String?
  createdBy          User?                    @relation("InvTxCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime                 @default(now())

  @@index([productId, batchId, branchId, stockStatus])
  @@index([branchId, stockStatus])
  @@index([companyId, transactionDate])
  @@index([transactionType])
}
