{
  "name": "healthpilot-backend",
  "version": "1.0.0",
  "description": "HealthPilot.ai Multi-Branch Hospital Pharmacy ERP - Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate --schema=prisma && tsc",
    "start": "node dist/server.js",
    "postinstall": "prisma generate --schema=prisma",
    "prisma:generate": "prisma generate --schema=prisma",
    "prisma:migrate": "prisma migrate dev --schema=prisma",
    "prisma:seed": "tsx src/scripts/seed.ts",
    "prisma:studio": "prisma studio --schema=prisma",
    "verify:seed": "tsx src/scripts/verifySeed.ts",
    "verify:notifications": "tsx src/scripts/verifyNotifications.ts",
    "verify:internal-fulfilment": "tsx src/scripts/verifyInternalFulfilment.ts"
  },
  "prisma": {
    "schema": "prisma",
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "socket.io-client": "^4.8.1"
  }
}
